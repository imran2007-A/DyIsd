<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DyIsd</RootNamespace>
    <AssemblyName>DyIsd</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DyIsd.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <!-- WPF0001: ThemeMode (Fluent look for the settings window) is marked experimental -->
    <!-- WFO0003: WinForms prefers a different DPI setting, but this is a WPF app and needs the manifest -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Jarvis: records the microphone at 16 kHz -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="Ical.Net" Version="4.3.1" />
    <!-- Jarvis: local speech recognition (whisper.cpp). Vulkan runs it on the graphics card,
         the CPU runtime is the fallback when there's no usable GPU. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\DyIsd.ico" LogicalName="DyIsd.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

  <!-- Whisper ships speech engines for every platform; a 64-bit Windows build only needs its own (saves ~60 MB). -->
  <Target Name="TrimWhisperRuntimes" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <RemoveDir Directories="$(PublishDir)runtimes/vulkan/linux-x64;$(PublishDir)runtimes/win-arm64;$(PublishDir)runtimes/win-x86" />
  </Target>

</Project>
