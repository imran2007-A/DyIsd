<Window x:Class="DyIsd.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DyIsd.Controls"
        Title="DyIsd island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Width="480" Height="250"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource IslandFg}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- ============ shared styles ============ -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Mute" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandMute}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource IslandHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}"/>
            <Setter Property="Background" Value="{DynamicResource IslandBtn}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        </Style>

        <!-- ============ MEDIA ============ -->
        <DataTemplate x:Key="media-c">
            <Grid Margin="8,0" FlowDirection="{DynamicResource CompactFlow}">
                <Border Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left" Background="{Binding ArtBrush}"/>
                <c:Equalizer HorizontalAlignment="Right" Width="22" Height="14" IsPlaying="{Binding IsPlaying}" Fill="{DynamicResource Accent}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="media-e">
            <Grid Margin="16,14,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="58" Height="58" CornerRadius="12" Background="{Binding ArtBrush}"/>
                    <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="10" Padding="8,2" Background="{DynamicResource IslandBtn}">
                        <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource IslandMute}"/>
                    </Border>
                    <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource Mute}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource IslandMute}" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource IslandMute}" Typography.NumeralAlignment="Tabular"/>
                    <c:ProgressLine Height="4" Margin="10,0" VerticalAlignment="Center" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"/>
                </DockPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Tag="prev" Click="OnAction" ToolTip="Previous"/>
                    <Button Style="{StaticResource IconBtn}" Content="{Binding PlayGlyph}" Tag="toggle" Click="OnAction" FontSize="20" Width="42" Height="42" Margin="14,0" ToolTip="Play / pause"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Tag="next" Click="OnAction" ToolTip="Next"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============ FOCUS TIMER ============ -->
        <DataTemplate x:Key="timer-c">
            <Grid Margin="10,0" FlowDirection="{DynamicResource CompactFlow}">
                <c:RingProgress Width="20" Height="20" HorizontalAlignment="Left" Thickness="2.5" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding RemainingText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="timer-e">
            <Grid Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel VerticalAlignment="Center">
                    <c:RingProgress DockPanel.Dock="Left" Width="52" Height="52" Thickness="4" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RemainingText}" FontSize="32" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding SubText}" Style="{StaticResource Mute}"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource AccentBtn}" Content="{Binding PauseText}" Tag="tpause" Click="OnAction" MinWidth="72"/>
                    <Button Style="{StaticResource PillBtn}" Content="+5 min" Tag="t5" Click="OnAction" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource PillBtn}" Content="End" Tag="tend" Click="OnAction" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============ DOWNLOADS ============ -->
        <DataTemplate x:Key="dl-c">
            <Grid Margin="12,0" FlowDirection="{DynamicResource CompactFlow}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding ShortText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="dl-e">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}" FontSize="20"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillBtn}" Content="Open folder" Tag="dfolder" Click="OnAction"/>
                    <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Head}"/>
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mute}" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </DockPanel>
                <c:ProgressLine Grid.Row="1" Height="4" Margin="0,10,0,0" IsIndeterminate="True" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"/>
            </Grid>
        </DataTemplate>

        <!-- ============ VOLUME / BRIGHTNESS ============ -->
        <DataTemplate x:Key="level">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}"/>
                <c:ProgressLine Grid.Column="1" Height="4" Margin="12,0" VerticalAlignment="Center" Value="{Binding Value}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"/>
                <TextBlock Grid.Column="2" Text="{Binding Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource IslandMute}" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <!-- ============ ONE-LINE PILL (battery, done messages) ============ -->
        <DataTemplate x:Key="pill">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"/>
                <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding Title}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Right}" Foreground="{Binding RightBrush}" VerticalAlignment="Center" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                           Visibility="{Binding Right, Converter={StaticResource NullToCollapsed}}"/>
                <Button Grid.Column="3" Style="{StaticResource PillBtn}" Content="{Binding Button1}" Tag="{Binding Tag1}" Click="OnAction" Margin="10,0,0,0" Padding="10,5"
                        Visibility="{Binding Button1, Converter={StaticResource NullToCollapsed}}"/>
            </Grid>
        </DataTemplate>

        <!-- ============ TWO-LINE CARD (clipboard, deadline, download done) ============ -->
        <DataTemplate x:Key="card">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="18"/>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Head}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mute}" Margin="0,1,0,0"
                               Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PillBtn}" Content="{Binding Button1}" Tag="{Binding Tag1}" Click="OnAction" Padding="10,5"
                            Visibility="{Binding Button1, Converter={StaticResource NullToCollapsed}}"/>
                    <Button Style="{StaticResource PillBtn}" Content="{Binding Button2}" Tag="{Binding Tag2}" Click="OnAction" Padding="10,5" Margin="6,0,0,0"
                            Visibility="{Binding Button2, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- same card, but the second line is monospace (copied text) -->
        <DataTemplate x:Key="clip">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="18"/>
                <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Head}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mute}" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"
                               Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============ NOTIFICATION ============ -->
        <DataTemplate x:Key="notif">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="38" Height="38" VerticalAlignment="Center">
                    <Ellipse Fill="{Binding AvatarBrush}"/>
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Image Source="{Binding Image}" Width="30" Height="30" Visibility="{Binding Image, Converter={StaticResource NullToCollapsed}}"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AppName}" Style="{StaticResource Mute}" Margin="8,0,0,0" MaxWidth="120"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Head}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="12" Width="30" Height="30" Tag="dismiss" Click="OnAction" VerticalAlignment="Center" ToolTip="Dismiss"/>
            </Grid>
        </DataTemplate>

        <!-- ============ SECOND-ACTIVITY BUBBLE ============ -->
        <DataTemplate x:Key="bubble-media">
            <Border Width="24" Height="24" CornerRadius="12" Background="{Binding ArtBrush}"/>
        </DataTemplate>
        <DataTemplate x:Key="bubble-timer">
            <c:RingProgress Width="22" Height="22" Thickness="2.5" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"/>
        </DataTemplate>
        <DataTemplate x:Key="bubble-download">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <StackPanel x:Name="Row" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,8,16,0">
            <Border x:Name="Pill" Width="200" Height="36" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource IslandBg}" BorderBrush="{DynamicResource IslandBorder}" BorderThickness="1"
                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Radius}}"
                    ClipToBounds="True" Cursor="Hand" FlowDirection="LeftToRight"
                    MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
                    MouseLeftButtonDown="Pill_MouseLeftButtonDown" MouseMove="Pill_MouseMove" MouseLeftButtonUp="Pill_MouseLeftButtonUp"
                    MouseWheel="Pill_MouseWheel">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PillScale" ScaleX="0.6" ScaleY="0.6"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.26" Color="Black"/>
                </Border.Effect>
                <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border x:Name="Bubble" Width="36" Height="36" CornerRadius="18" Margin="8,0,0,0" VerticalAlignment="Top"
                    Opacity="0" IsHitTestVisible="False" Cursor="Hand" FlowDirection="LeftToRight"
                    Background="{DynamicResource IslandBg}" BorderBrush="{DynamicResource IslandBorder}" BorderThickness="1"
                    MouseLeftButtonUp="Bubble_MouseLeftButtonUp" ToolTip="Switch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.24" Color="Black"/>
                </Border.Effect>
                <ContentPresenter x:Name="BubblePresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
