<Window x:Class="DyIsd.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DyIsd.Controls"
        Title="DyIsd island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Width="420" Height="250"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource IslandFg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- ============ shared styles ============ -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Mute" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandMute}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource IslandHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}"/>
            <Setter Property="Background" Value="{DynamicResource IslandBtn}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WhiteBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- ============ MEDIA ============ -->
        <DataTemplate x:Key="media-c">
            <Grid Margin="7,0,10,0" FlowDirection="{DynamicResource CompactFlow}">
                <Border Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left" Background="{Binding ArtBrush}"/>
                <c:Equalizer HorizontalAlignment="Right" Width="22" Height="14" IsPlaying="{Binding IsPlaying}" Fill="{Binding BarBrush}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="media-e">
            <Grid Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="12" Background="{Binding ArtBrush}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE8A7;" FontSize="13" Width="30" Height="30" VerticalAlignment="Top"
                            Tag="jump" Click="OnAction" ToolTip="Open the app"/>
                    <StackPanel Margin="12,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource Mute}" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource IslandMute}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- drag to seek -->
                <DockPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource IslandMute}" Typography.NumeralAlignment="Tabular" Width="34"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" FontSize="11" Foreground="{DynamicResource IslandMute}" Typography.NumeralAlignment="Tabular" Width="38" TextAlignment="Right"/>
                    <c:ProgressLine Height="5" Margin="6,0" VerticalAlignment="Center" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="White"
                                    Interactive="True" IsEnabled="{Binding CanSeek}" ValueChosen="OnSeek" Cursor="Hand"/>
                </DockPanel>

                <!-- shuffle, previous, play/pause, next, repeat -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE8B1;" FontSize="14" Foreground="{Binding ShuffleBrush}" Tag="shuffle" Click="OnAction" IsEnabled="{Binding CanShuffle}" ToolTip="Shuffle"/>
                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE892;" Tag="prev" Click="OnAction" ToolTip="Previous"/>
                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="{Binding PlayGlyph}" Tag="toggle" Click="OnAction" FontSize="22" Width="44" Height="44" ToolTip="Play / pause"/>
                    <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#xE893;" Tag="next" Click="OnAction" ToolTip="Next"/>
                    <Button Grid.Column="4" Style="{StaticResource IconBtn}" Content="{Binding RepeatGlyph}" FontSize="14" Foreground="{Binding RepeatBrush}" Tag="repeat" Click="OnAction" IsEnabled="{Binding CanRepeat}" ToolTip="Repeat"/>
                </Grid>

                <!-- volume -->
                <DockPanel Grid.Row="3" Margin="4,8,4,0">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE993;" FontSize="12" Foreground="{DynamicResource IslandMute}"/>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE995;" FontSize="12" Foreground="{DynamicResource IslandMute}"/>
                    <c:ProgressLine Height="5" Margin="10,0" VerticalAlignment="Center" Value="{Binding Volume}" Track="{DynamicResource IslandTrack}" Fill="White"
                                    Interactive="True" LiveUpdate="True" ValueChosen="OnVolume" Cursor="Hand"/>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- paused from the island: a tiny dot you can click to reopen the player -->
        <DataTemplate x:Key="media-dot">
            <Grid/>
        </DataTemplate>

        <!-- ============ CALLS (like iPhone) ============ -->
        <DataTemplate x:Key="call-c">
            <Grid Margin="11,0,12,0" FlowDirection="{DynamicResource CompactFlow}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE717;" Foreground="{DynamicResource Good}" FontSize="15"/>
                    <TextBlock Text="{Binding Elapsed}" FlowDirection="LeftToRight" Foreground="{DynamicResource Good}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
                <Grid HorizontalAlignment="Right" Width="24" Height="16">
                    <c:VoiceWave Level="{Binding Level}" Fill="{DynamicResource Good}" Visibility="{Binding Muted, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEC54;" FontSize="14" Foreground="{DynamicResource Bad}" HorizontalAlignment="Center"
                               Visibility="{Binding Muted, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="call-e">
            <DockPanel Margin="16,0" VerticalAlignment="Center">
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Chip}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE717;" Foreground="{DynamicResource Good}" FontSize="18" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Tag="mute" Click="OnAction" Width="44" Height="44" Focusable="False" Cursor="Hand" ToolTip="Mute / unmute">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="22" Background="{Binding MuteBack}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding MuteGlyph}" Foreground="{Binding MuteFore}" FontSize="17" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="jump" Click="OnAction" Width="44" Height="44" Margin="10,0,0,0" Focusable="False" Cursor="Hand" ToolTip="Go to the call">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="22" Background="{DynamicResource Good}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" Foreground="Black" FontSize="16" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Who}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mute}" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- ============ FOCUS TIMER ============ -->
        <DataTemplate x:Key="timer-c">
            <Grid Margin="9,0,12,0" FlowDirection="{DynamicResource CompactFlow}">
                <c:RingProgress Width="19" Height="19" HorizontalAlignment="Left" Thickness="2.5" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Orange}"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding RemainingText}" FontWeight="SemiBold" Foreground="{DynamicResource Orange}" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="timer-e">
            <Grid Margin="18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel VerticalAlignment="Center">
                    <c:RingProgress DockPanel.Dock="Left" Width="48" Height="48" Thickness="4" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Orange}"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RemainingText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Orange}" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding SubText}" Style="{StaticResource Mute}"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource WhiteBtn}" Content="{Binding PauseText}" Tag="tpause" Click="OnAction" MinWidth="76"/>
                    <Button Style="{StaticResource PillBtn}" Content="+5 min" Tag="t5" Click="OnAction" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource PillBtn}" Content="End" Tag="tend" Click="OnAction" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============ DOWNLOADS ============ -->
        <DataTemplate x:Key="dl-c">
            <Grid Margin="11,0,12,0" FlowDirection="{DynamicResource CompactFlow}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding ShortText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="dl-e">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}" FontSize="20"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillBtn}" Content="Folder" Tag="dfolder" Click="OnAction"/>
                    <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Head}"/>
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mute}" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </DockPanel>
                <c:ProgressLine Grid.Row="1" Height="5" Margin="0,10,0,0" IsIndeterminate="True" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"/>
            </Grid>
        </DataTemplate>

        <!-- ============ VOLUME / BRIGHTNESS ============ -->
        <DataTemplate x:Key="level">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}"/>
                <c:ProgressLine Grid.Column="1" Height="5" Margin="12,0" VerticalAlignment="Center" Value="{Binding Value}" Track="{DynamicResource IslandTrack}" Fill="White"/>
                <TextBlock Grid.Column="2" Text="{Binding Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource IslandMute}" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <!-- ============ ONE-LINE PILL (battery, short messages) ============ -->
        <DataTemplate x:Key="pill">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"/>
                <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding Title}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Right}" Foreground="{Binding RightBrush}" VerticalAlignment="Center" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                           Visibility="{Binding Right, Converter={StaticResource NullToCollapsed}}"/>
                <Button Grid.Column="3" Style="{StaticResource PillBtn}" Content="{Binding Button1}" Tag="{Binding Tag1}" Click="OnAction" Margin="10,0,0,0" Padding="11,5"
                        Visibility="{Binding Button1, Converter={StaticResource NullToCollapsed}}"/>
            </Grid>
        </DataTemplate>

        <!-- ============ TWO-LINE CARD (deadline, download done, earbuds) ============ -->
        <DataTemplate x:Key="card">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="19"/>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Head}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mute}" Margin="0,1,0,0"
                               Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Right}" Foreground="{Binding RightBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"
                               Visibility="{Binding Right, Converter={StaticResource NullToCollapsed}}"/>
                    <Button Style="{StaticResource WhiteBtn}" Content="{Binding Button1}" Tag="{Binding Tag1}" Click="OnAction" Padding="12,5"
                            Visibility="{Binding Button1, Converter={StaticResource NullToCollapsed}}"/>
                    <Button Style="{StaticResource PillBtn}" Content="{Binding Button2}" Tag="{Binding Tag2}" Click="OnAction" Padding="12,5" Margin="6,0,0,0"
                            Visibility="{Binding Button2, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- same card, second line in monospace (copied text) -->
        <DataTemplate x:Key="clip">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="18"/>
                <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Head}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mute}" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"
                               Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Border x:Name="Pill" Width="190" Height="34" Margin="14,8,14,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                Opacity="0" Background="{DynamicResource IslandBg}" BorderBrush="{DynamicResource IslandBorder}" BorderThickness="1"
                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Radius}}"
                ClipToBounds="True"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown" MouseMove="Pill_MouseMove" MouseLeftButtonUp="Pill_MouseLeftButtonUp"
                MouseRightButtonUp="Pill_MouseRightButtonUp" MouseWheel="Pill_MouseWheel"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave" Cursor="Hand">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="0.5" ScaleY="0.5"/>
            </Border.RenderTransform>
            <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- camera in use (green, like iPhone) -->
        <Ellipse x:Name="PrivacyDot" Width="9" Height="9" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="14,20,14,0"
                 Opacity="0" IsHitTestVisible="False" Fill="{DynamicResource Good}">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="DotShift"/>
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</Window>
