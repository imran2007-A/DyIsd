<Window x:Class="DyIsd.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DyIsd.Controls"
        Title="DyIsd island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        Width="420" Height="250"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource IslandFg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- ============ shared styles ============ -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Mute" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandMute}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource IslandHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}"/>
            <Setter Property="Background" Value="{DynamicResource IslandBtn}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- small Home button in every opened view: jumps to the Home panel -->
        <Style x:Key="HomeBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Content" Value="&#xE80F;"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Tag" Value="home"/>
            <Setter Property="ToolTip" Value="Home"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandMute}"/>
        </Style>
        <Style x:Key="WhiteBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- ============ MEDIA ============ -->
        <DataTemplate x:Key="media-c">
            <Grid Margin="7,0,10,0" FlowDirection="{DynamicResource CompactFlow}">
                <Border Width="22" Height="22" CornerRadius="6" HorizontalAlignment="Left" Background="{Binding ArtBrush}"/>
                <c:Eyes HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                <c:Equalizer HorizontalAlignment="Right" Width="22" Height="14" IsPlaying="{Binding IsPlaying}" Fill="{Binding BarBrush}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="media-e">
            <Grid Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="12" Background="{Binding ArtBrush}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE8A7;" FontSize="13" Width="30" Height="30" VerticalAlignment="Top"
                            Tag="jump" Click="OnAction" ToolTip="Open the app"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource HomeBtn}" Click="OnAction" VerticalAlignment="Top"/>
                    <StackPanel Margin="12,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource Mute}" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource IslandMute}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- drag to seek -->
                <DockPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource IslandMute}" Typography.NumeralAlignment="Tabular" Width="34"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" FontSize="11" Foreground="{DynamicResource IslandMute}" Typography.NumeralAlignment="Tabular" Width="38" TextAlignment="Right"/>
                    <c:ProgressLine Height="5" Margin="6,0" VerticalAlignment="Center" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="White"
                                    Interactive="True" IsEnabled="{Binding CanSeek}" ValueChosen="OnSeek" Cursor="Hand"/>
                </DockPanel>

                <!-- shuffle, previous, play/pause, next, repeat -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <!-- on/off isn't just brighter: a dot shows under the one that's on, like iOS -->
                    <Grid>
                        <Button Style="{StaticResource IconBtn}" Content="&#xE8B1;" FontSize="14" Foreground="{Binding ShuffleBrush}" Tag="shuffle" Click="OnAction" IsEnabled="{Binding CanShuffle}" ToolTip="Shuffle"/>
                        <Ellipse Width="4" Height="4" Fill="White" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" IsHitTestVisible="False"
                                 Visibility="{Binding Shuffle, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE892;" Tag="prev" Click="OnAction" ToolTip="Previous"/>
                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="{Binding PlayGlyph}" Tag="toggle" Click="OnAction" FontSize="22" Width="44" Height="44" ToolTip="Play / pause"/>
                    <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#xE893;" Tag="next" Click="OnAction" ToolTip="Next"/>
                    <Grid Grid.Column="4">
                        <Button Style="{StaticResource IconBtn}" Content="{Binding RepeatGlyph}" FontSize="14" Foreground="{Binding RepeatBrush}" Tag="repeat" Click="OnAction" IsEnabled="{Binding CanRepeat}" ToolTip="Repeat"/>
                        <Ellipse Width="4" Height="4" Fill="White" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2" IsHitTestVisible="False"
                                 Visibility="{Binding RepeatOn, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>

                <!-- volume, and where the sound goes (like AirPlay) -->
                <DockPanel Grid.Row="3" Margin="4,8,0,0">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE993;" FontSize="12" Foreground="{DynamicResource IslandMute}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE7F5;" FontSize="13" Width="28" Height="28" Margin="4,0,0,0"
                            Tag="outputs" Click="OnAction" ToolTip="Play on… (speakers, headphones)"/>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="&#xE995;" FontSize="12" Foreground="{DynamicResource IslandMute}"/>
                    <c:ProgressLine Height="5" Margin="10,0" VerticalAlignment="Center" Value="{Binding Volume}" Track="{DynamicResource IslandTrack}" Fill="White"
                                    Interactive="True" LiveUpdate="True" ValueChosen="OnVolume" Cursor="Hand"/>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- pick speakers / headphones -->
        <DataTemplate x:Key="media-out">
            <DockPanel Margin="10,10,10,10">
                <DockPanel DockPanel.Dock="Top" Margin="6,0,0,6">
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconBtn}" Content="&#xE72B;" FontSize="12" Width="28" Height="28" Tag="outputs" Click="OnAction" ToolTip="Back"/>
                    <TextBlock Text="Play on" Style="{StaticResource Head}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding Tag}" Click="OnAction" Focusable="False" Cursor="Hand" Height="36" HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="10,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource IslandHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="15" Width="22"/>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Glyph}" Text="{Binding Check}" FontSize="13" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource IslandFg}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </DataTemplate>

        <!-- paused from the island: a tiny dot you can click to reopen the player -->
        <DataTemplate x:Key="media-dot">
            <Grid/>
        </DataTemplate>

        <!-- ============ CALLS (like iPhone) ============ -->
        <DataTemplate x:Key="call-c">
            <Grid Margin="11,0,12,0" FlowDirection="{DynamicResource CompactFlow}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE717;" Foreground="{DynamicResource Good}" FontSize="15"/>
                    <TextBlock Text="{Binding Elapsed}" FlowDirection="LeftToRight" Foreground="{DynamicResource Good}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
                <Grid HorizontalAlignment="Right" Width="24" Height="16">
                    <c:VoiceWave Level="{Binding Level}" Fill="{DynamicResource Good}" Visibility="{Binding Muted, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEC54;" FontSize="14" Foreground="{DynamicResource Bad}" HorizontalAlignment="Center"
                               Visibility="{Binding Muted, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="call-e">
            <DockPanel Margin="16,0" VerticalAlignment="Center">
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource Chip}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE717;" Foreground="{DynamicResource Good}" FontSize="18" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Tag="mute" Click="OnAction" Width="44" Height="44" Focusable="False" Cursor="Hand" ToolTip="Mute / unmute">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="22" Background="{Binding MuteBack}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding MuteGlyph}" Foreground="{Binding MuteFore}" FontSize="17" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Style="{StaticResource HomeBtn}" Click="OnAction" Margin="0,0,6,0"/>
                    <Button Tag="jump" Click="OnAction" Width="44" Height="44" Margin="10,0,0,0" Focusable="False" Cursor="Hand" ToolTip="Go to the call">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="22" Background="{DynamicResource Good}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;" Foreground="Black" FontSize="16" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Who}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mute}" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- ============ FOCUS TIMER ============ -->
        <DataTemplate x:Key="timer-c">
            <Grid Margin="9,0,12,0" FlowDirection="{DynamicResource CompactFlow}">
                <c:RingProgress Width="19" Height="19" HorizontalAlignment="Left" Thickness="2.5" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Orange}"/>
                <c:Eyes Mood="Love" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding RemainingText}" FontWeight="SemiBold" Foreground="{DynamicResource Orange}" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="timer-e">
            <Grid Margin="18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel VerticalAlignment="Center">
                    <c:RingProgress DockPanel.Dock="Left" Width="48" Height="48" Thickness="4" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Orange}"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RemainingText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Orange}" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding SubText}" Style="{StaticResource Mute}"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource WhiteBtn}" Content="{Binding PauseText}" Tag="tpause" Click="OnAction" MinWidth="76"/>
                    <Button Style="{StaticResource PillBtn}" Content="+5 min" Tag="t5" Click="OnAction" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource PillBtn}" Content="End" Tag="tend" Click="OnAction" Margin="8,0,0,0"/>
                    <Button Style="{StaticResource HomeBtn}" Click="OnAction" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============ DOWNLOADS ============ -->
        <DataTemplate x:Key="dl-c">
            <Grid Margin="11,0,12,0" FlowDirection="{DynamicResource CompactFlow}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding ShortText}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="dl-e">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}" FontSize="20"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource HomeBtn}" Click="OnAction" Margin="6,0,0,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillBtn}" Content="Folder" Tag="dfolder" Click="OnAction"/>
                    <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Head}"/>
                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mute}" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </DockPanel>
                <c:ProgressLine Grid.Row="1" Height="5" Margin="0,10,0,0" IsIndeterminate="True" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"/>
            </Grid>
        </DataTemplate>

        <!-- ============ VOLUME / BRIGHTNESS ============ -->
        <DataTemplate x:Key="level">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}"/>
                <c:ProgressLine Grid.Column="1" Height="5" Margin="12,0" VerticalAlignment="Center" Value="{Binding Value}" Track="{DynamicResource IslandTrack}" Fill="White"/>
                <TextBlock Grid.Column="2" Text="{Binding Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource IslandMute}" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <!-- ============ ONE-LINE PILL (battery, short messages) ============ -->
        <DataTemplate x:Key="pill">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"/>
                <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding Title}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Right}" Foreground="{Binding RightBrush}" VerticalAlignment="Center" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                           Visibility="{Binding Right, Converter={StaticResource NullToCollapsed}}"/>
                <Button Grid.Column="3" Style="{StaticResource PillBtn}" Content="{Binding Button1}" Tag="{Binding Tag1}" Click="OnAction" Margin="10,0,0,0" Padding="11,5"
                        Visibility="{Binding Button1, Converter={StaticResource NullToCollapsed}}"/>
            </Grid>
        </DataTemplate>

        <!-- ============ CHARGING: bolt + "Charging", ring fills to the battery level ============ -->
        <DataTemplate x:Key="charging">
            <DockPanel Margin="14,0,8,0">
                <Grid DockPanel.Dock="Right" Width="28" Height="28" VerticalAlignment="Center">
                    <c:RingProgress Thickness="3" Sweep="True" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{Binding RightBrush}"/>
                    <TextBlock Text="{Binding Right}" FontSize="9" FontWeight="Bold" Foreground="{Binding RightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"/>
                <TextBlock Margin="10,0" Text="{Binding Title}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>

        <!-- ============ JARVIS ANSWER (AI brain): text that wraps ============ -->
        <DataTemplate x:Key="answer">
            <DockPanel Margin="16,11,16,10">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="17" VerticalAlignment="Top" Margin="0,1,12,0"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Subtitle}" Style="{StaticResource Mute}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource IslandFg}" FontSize="13.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="19"/>
            </DockPanel>
        </DataTemplate>

        <!-- ============ TWO-LINE CARD (deadline, download done, earbuds) ============ -->
        <DataTemplate x:Key="card">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="19"/>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Head}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mute}" Margin="0,1,0,0"
                               Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Right}" Foreground="{Binding RightBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"
                               Visibility="{Binding Right, Converter={StaticResource NullToCollapsed}}"/>
                    <Button Style="{StaticResource WhiteBtn}" Content="{Binding Button1}" Tag="{Binding Tag1}" Click="OnAction" Padding="12,5"
                            Visibility="{Binding Button1, Converter={StaticResource NullToCollapsed}}"/>
                    <Button Style="{StaticResource PillBtn}" Content="{Binding Button2}" Tag="{Binding Tag2}" Click="OnAction" Padding="12,5" Margin="6,0,0,0"
                            Visibility="{Binding Button2, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- same card, second line in monospace (copied text) -->
        <DataTemplate x:Key="clip">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontSize="18"/>
                <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Head}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mute}" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,0"
                               Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============ SILENT SWITCH (like iPhone's ring / silent switch) ============ -->
        <DataTemplate x:Key="silent">
            <Grid Margin="5,0,16,0">
                <Border HorizontalAlignment="Left" Width="52" Height="26" CornerRadius="13" Background="{Binding AvatarBrush}">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" Foreground="White" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.15">
                        <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.Angle" BeginTime="0:0:0.12">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.07" Value="-24"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="20"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-14"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="9"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.43" Value="-4"/>
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.52" Value="0"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Border>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Title}" Foreground="{Binding RightBrush}" FontWeight="SemiBold" FontSize="13.5"/>
            </Grid>
        </DataTemplate>

        <!-- ============ WINDOWS CLOCK: timer / stopwatch ============ -->
        <DataTemplate x:Key="clock-c">
            <Grid Margin="11,0,12,0" FlowDirection="{DynamicResource CompactFlow}">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding Accent}" FontSize="15" HorizontalAlignment="Left"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding Text}" FontWeight="SemiBold" Foreground="{Binding Accent}" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="clock-e">
            <DockPanel Margin="18,0" VerticalAlignment="Center">
                <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource Chip}">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding Accent}" FontSize="20" HorizontalAlignment="Center"/>
                </Border>
                <Button DockPanel.Dock="Right" Style="{StaticResource HomeBtn}" Click="OnAction" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PillBtn}" Content="Open Clock" Tag="jump" Click="OnAction" VerticalAlignment="Center"/>
                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}" FontSize="28" FontWeight="SemiBold" Foreground="{Binding Accent}" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Mute}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- ============ INCOMING CALL (ringing) ============ -->
        <DataTemplate x:Key="ring-e">
            <DockPanel Margin="14,0" VerticalAlignment="Center">
                <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24" Background="{Binding AppColor}">
                    <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Tag="decline" Click="OnAction" Width="46" Height="46" Focusable="False" Cursor="Hand" ToolTip="Decline">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="23" Background="{DynamicResource Bad}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE778;" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Tag="answer" Click="OnAction" Width="46" Height="46" Margin="12,0,0,0" Focusable="False" Cursor="Hand" ToolTip="Answer">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="23" Background="{DynamicResource Good}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE717;" Foreground="White" FontSize="18" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.Angle" Duration="0:0:1.4">
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="-16"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.14" Value="16"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.22" Value="-16"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="16"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.38" Value="-10"/>
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.46" Value="0"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Who}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mute}"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- ============ FILE TRANSFERS (Bluetooth / Nearby Share) ============ -->
        <DataTemplate x:Key="xfer-c">
            <Grid Margin="11,0,10,0" FlowDirection="{DynamicResource CompactFlow}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE72D;" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                <c:RingProgress Width="19" Height="19" HorizontalAlignment="Right" Thickness="2.5" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"
                                Visibility="{Binding KnowsProgress, Converter={StaticResource BoolToVis}}"/>
                <c:Equalizer HorizontalAlignment="Right" Width="20" Height="12" IsPlaying="True" Fill="{DynamicResource Accent}"
                             Visibility="{Binding Unknown, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="xfer-e">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE72D;" Foreground="{DynamicResource Accent}" FontSize="20"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource HomeBtn}" Click="OnAction" Margin="6,0,0,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontWeight="SemiBold" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Head}"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Mute}"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <c:ProgressLine Height="5" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"
                                    Visibility="{Binding KnowsProgress, Converter={StaticResource BoolToVis}}"/>
                    <c:ProgressLine Height="5" IsIndeterminate="True" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"
                                    Visibility="{Binding Unknown, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ============ JARVIS ============ -->
        <DataTemplate x:Key="jarvis">
            <Grid Margin="7,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- the island's eyes: excited while it listens, thinking while it works -->
                <c:Eyes Grid.Column="0" Mood="{Binding Mood}" EyeSize="6" Width="34" Margin="2,0,0,0" VerticalAlignment="Center"/>
                <Ellipse Width="26" Height="26" Visibility="Collapsed">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#64D2FF" Offset="0"/>
                            <GradientStop Color="#5E5CE6" Offset="0.55"/>
                            <GradientStop Color="#BF5AF2" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding Text}" Style="{StaticResource Head}" VerticalAlignment="Center"/>
                <Grid Grid.Column="2" Width="28" Height="16">
                    <c:VoiceWave Level="{Binding Level}" Fill="#64D2FF" Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}"/>
                    <c:Equalizer IsPlaying="True" Fill="#BF5AF2" Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ============ SECOND ACTIVITY (the small circle) ============ -->
        <DataTemplate x:Key="b-media">
            <Border Width="20" Height="20" CornerRadius="10" Background="{Binding ArtBrush}"/>
        </DataTemplate>
        <DataTemplate x:Key="b-call">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE717;" Foreground="{DynamicResource Good}" FontSize="14"/>
        </DataTemplate>
        <DataTemplate x:Key="b-ring">
            <Border Width="22" Height="22" CornerRadius="11" Background="{Binding AppColor}">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE717;" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="b-timer">
            <c:RingProgress Width="18" Height="18" Thickness="2.5" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Orange}"/>
        </DataTemplate>
        <DataTemplate x:Key="b-clock">
            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{Binding Accent}" FontSize="14"/>
        </DataTemplate>
        <DataTemplate x:Key="b-dl">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" Foreground="{DynamicResource Accent}" FontSize="14"/>
        </DataTemplate>
        <DataTemplate x:Key="b-xfer">
            <!-- an arrow inside, so it isn't told apart from the timer ring by colour alone -->
            <Grid Width="20" Height="20">
                <c:RingProgress Thickness="2.5" Value="{Binding Progress}" Track="{DynamicResource IslandTrack}" Fill="{DynamicResource Accent}"/>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" FontSize="8" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- ============ FACE: two eyes when nothing else is on (click: Home) ============ -->
        <DataTemplate x:Key="face">
            <c:Eyes Mood="{Binding Mood}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- ============ CLAUDE CODE: Thinking / Editing / Done ============ -->
        <SolidColorBrush x:Key="ClaudeOrange" Color="#D97757"/>
        <BitmapImage x:Key="ClaudeLogo" UriSource="pack://application:,,,/Assets/claude.png"/>
        <Style x:Key="ClaudeMark" TargetType="Image">
            <Setter Property="Source" Value="{StaticResource ClaudeLogo}"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        </Style>

        <DataTemplate x:Key="claude-c">
            <Grid Margin="12,0,13,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Image Style="{StaticResource ClaudeMark}"/>
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="13.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <c:Eyes Mood="{Binding Mood}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Elapsed}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="claude-e">
            <DockPanel Margin="16,12,14,12">
                <DockPanel DockPanel.Dock="Top">
                    <Image DockPanel.Dock="Left" Style="{StaticResource ClaudeMark}" Width="14" Height="14"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource HomeBtn}" Click="OnAction" Margin="6,-6,-6,-6"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                    <c:Eyes DockPanel.Dock="Right" Mood="{Binding Mood}" EyeSize="5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Header}" Style="{StaticResource Mute}" Margin="8,0" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillBtn}" Content="Open" Tag="jump" Click="OnAction" Padding="14,5"/>
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource ClaudeOrange}"/>
                        <Run Text="  "/><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource IslandMute}"/>
                    </TextBlock>
                </DockPanel>
                <TextBlock Text="{Binding Task}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,8,0,0"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="b-claude">
            <Grid>
                <Image Style="{StaticResource ClaudeMark}" Width="14" Height="14" HorizontalAlignment="Center"/>
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Good}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                         Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>

        <!-- ============ HOME: date, cards, tabs (Win + Shift + H or click the face) ============ -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12" Padding="8,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a big round button on a card (white ring, like the reel) -->
        <Style x:Key="CardBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="R" Stroke="White" StrokeThickness="2.2" Fill="#33000000"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="R" Property="Fill" Value="#55000000"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="R" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
        </Style>

        <!-- a row in a Home list (notifications, clipboard): hover to highlight -->
        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource IslandFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource IslandHover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="home">
            <Grid Margin="10,6,10,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- header: eyes, date, time, more -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <c:Eyes Mood="{Binding Claude.Mood}" EyeSize="3.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Date}" Foreground="{DynamicResource IslandMute}" FontSize="11.5" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Time}" FontWeight="Bold" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
                <Button Style="{StaticResource IconBtn}" Content="&#xE712;" FontSize="14" Width="24" Height="20" HorizontalAlignment="Right" Tag="cc" Click="OnAction" ToolTip="Control Center"/>

                <!-- ===== Home: three cards ===== -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,4,0,4" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=home}">
                    <!-- Claude Code -->
                    <Border CornerRadius="15" Margin="0,0,4,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0E1420" Offset="0"/>
                                <GradientStop Color="#0D2552" Offset="0.55"/>
                                <GradientStop Color="#1F6FEB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="10,8,8,8">
                            <TextBlock Text="Claude Code" Style="{StaticResource CardLabel}"/>
                            <Button Style="{StaticResource CardBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Tag="tab:claude" Click="OnAction" ToolTip="Claude Code">
                                <Image Style="{StaticResource ClaudeMark}" Width="12" Height="12"/>
                            </Button>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding ClaudeBig}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ClaudeSub}" FontSize="10" Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Music: tinted with the album colour -->
                    <Border CornerRadius="15" Margin="4,0,4,0" ClipToBounds="True" Background="{Binding MusicTint}">
                        <Grid>
                            <Border CornerRadius="15">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F2100608" Offset="0"/>
                                        <GradientStop Color="#99100608" Offset="0.5"/>
                                        <GradientStop Color="#10100608" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Margin="10,8,8,8">
                                <TextBlock Text="Music" Style="{StaticResource CardLabel}"/>
                                <Border Width="30" Height="30" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{Binding Media.ArtBrush}"/>
                                <DockPanel VerticalAlignment="Bottom">
                                    <Button DockPanel.Dock="Right" Tag="toggle" Click="OnAction" Width="26" Height="26" Focusable="False" Cursor="Hand" VerticalAlignment="Bottom"
                                            Visibility="{Binding Media.HasSession, Converter={StaticResource BoolToVis}}" ToolTip="Play / pause">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="B" CornerRadius="13" Background="White">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Media.PlayGlyph}" Foreground="Black" FontSize="13" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="{Binding MusicBig}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding MusicSub}" FontSize="10" Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Reminders -->
                    <Border CornerRadius="15" Margin="4,0,0,0" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                                <GradientStop Color="#0A1A14" Offset="0"/>
                                <GradientStop Color="#0F4A33" Offset="0.5"/>
                                <GradientStop Color="#30D158" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="10,8,8,8">
                            <TextBlock Text="Reminders" Style="{StaticResource CardLabel}"/>
                            <Button Style="{StaticResource CardBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Tag="tab:rem" Click="OnAction" ToolTip="Reminders">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" Foreground="White" FontSize="10"/>
                            </Button>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding RemBig}" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="{Binding RemSub}" FontSize="10" Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ===== Claude ===== -->
                <Grid Grid.Row="1" Margin="4,8,4,6" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=claude}">
                    <StackPanel Visibility="{Binding Claude.IsActive, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Style="{StaticResource ClaudeMark}" Width="18" Height="18"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Claude.Elapsed}" FontSize="16" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="{Binding Claude.Header}" Style="{StaticResource Mute}" Margin="10,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Claude.Task}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="0,10,0,0"/>
                        <TextBlock Margin="0,8,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Claude.Status, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource ClaudeOrange}"/>
                            <Run Text="  "/><Run Text="{Binding Claude.Detail, Mode=OneWay}" Foreground="{DynamicResource IslandMute}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Claude.IsActive, Converter={StaticResource InverseBoolToVis}}">
                        <c:Eyes Mood="Sleep" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ClaudeIdle}" Style="{StaticResource Mute}" HorizontalAlignment="Center" Margin="0,10,0,0" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource PillBtn}" Content="Open" Tag="jump-claude" Click="OnAction" Margin="0,0,8,0"
                                Visibility="{Binding Claude.IsActive, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource WhiteBtn}" Content="Connect Claude Code" Tag="claude-connect" Click="OnAction"
                                Visibility="{Binding Claude.Connected, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Music: the full player ===== -->
                <Grid Grid.Row="1" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=music}">
                    <ContentControl Width="366" HorizontalAlignment="Center" Content="{Binding Media}" ContentTemplate="{StaticResource media-e}"
                                    Visibility="{Binding Media.HasSession, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Nothing playing" Style="{StaticResource Mute}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Media.HasSession, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>

                <!-- ===== Reminders: type one and press Enter, tick them off ===== -->
                <DockPanel Grid.Row="1" Margin="0,6" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=rem}">
                    <Border DockPanel.Dock="Top" CornerRadius="12" Background="{DynamicResource IslandBtn}" Margin="2,0,2,4">
                        <Grid>
                            <TextBox x:Name="RemBox" KeyDown="RemBox_KeyDown" Background="Transparent" BorderThickness="0" Padding="10,6"
                                     Foreground="{DynamicResource IslandFg}" CaretBrush="White" FontSize="13" SelectionBrush="{DynamicResource Accent}"/>
                            <TextBlock Text="Add a reminder… (try &quot;call mom at 6 pm&quot;)" Style="{StaticResource Mute}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=RemBox, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <ItemsControl ItemsSource="{Binding Reminders.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="4,2">
                                            <Button DockPanel.Dock="Left" Tag="rem-tick" Click="OnAction" Width="22" Height="22" Focusable="False" Cursor="Hand" ToolTip="Done / not done">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="Transparent">
                                                            <Ellipse x:Name="C" Width="16" Height="16" Stroke="{DynamicResource IslandMute}" StrokeThickness="1.5"/>
                                                            <TextBlock x:Name="K" Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="9" Foreground="Black" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="C" Property="Stroke" Value="White"/></Trigger>
                                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                                <Setter TargetName="C" Property="Fill" Value="{DynamicResource Good}"/>
                                                                <Setter TargetName="C" Property="Stroke" Value="{DynamicResource Good}"/>
                                                                <Setter TargetName="K" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="9" Width="20" Height="20" Tag="rem-del" Click="OnAction" ToolTip="Delete"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding WhenText}" Style="{StaticResource Mute}" FontSize="11" Margin="8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Text}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Done}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="Nothing to do · say &quot;Jarvis, remind me to…&quot;" Style="{StaticResource Mute}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding NoReminders, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </DockPanel>

                <!-- ===== Notifications ===== -->
                <Grid Grid.Row="1" Margin="0,6" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=notes-in}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding App}" Style="{StaticResource Mute}"/>
                                        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="8,0">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Body, Mode=OneWay}" Foreground="{DynamicResource IslandMute}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource Mute}" FontSize="11"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding NotifStatus}" Style="{StaticResource Mute}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding NoNotifs, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- ===== Timer: focus presets, or the running one ===== -->
                <Grid Grid.Row="1" Margin="0,6" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=timer}">
                    <ContentControl Width="330" Height="128" Content="{Binding Focus}" ContentTemplate="{StaticResource timer-e}"
                                    Visibility="{Binding FocusOn, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding FocusOn, Converter={StaticResource InverseBoolToVis}}">
                        <c:Eyes Mood="Love" HorizontalAlignment="Center" EyeSize="8"/>
                        <TextBlock Text="Start a focus session" Style="{StaticResource Mute}" HorizontalAlignment="Center" Margin="0,10,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PillBtn}" Content="15 min" Tag="focus:15" Click="OnAction" Margin="4,0"/>
                            <Button Style="{StaticResource WhiteBtn}" Content="25 min" Tag="focus:25" Click="OnAction" Margin="4,0"/>
                            <Button Style="{StaticResource PillBtn}" Content="45 min" Tag="focus:45" Click="OnAction" Margin="4,0"/>
                            <Button Style="{StaticResource PillBtn}" Content="60 min" Tag="focus:60" Click="OnAction" Margin="4,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== Tray: files dropped on the island ===== -->
                <Grid Grid.Row="1" Margin="0,6" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=tray}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Tray}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="122" Height="76" Margin="4" CornerRadius="14" Background="{DynamicResource IslandBtn}" Cursor="Hand"
                                            ToolTip="{Binding Path}" MouseLeftButtonDown="TrayItem_Down" MouseMove="TrayItem_MouseMove" MouseLeftButtonUp="TrayItem_Click">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" Margin="8,0">
                                                <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" FontSize="9" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,4,4,0" Tag="tray-remove" Click="OnAction" ToolTip="Remove from tray"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoTray, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7B8;" FontSize="26" Foreground="{DynamicResource IslandMute}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop files on the island to keep them here, then drag them out anywhere" Style="{StaticResource Mute}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Clipboard history ===== -->
                <Grid Grid.Row="1" Margin="0,4" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=clip}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Clips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowBtn}" Tag="clip" Click="OnAction" ToolTip="Copy again">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Mute}" FontSize="11" Margin="10,0,0,0"/>
                                            <TextBlock Text="{Binding Short}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Text you copy shows up here · click one to copy it again" Style="{StaticResource Mute}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding NoClips, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- ===== Notes ===== -->
                <Border Grid.Row="1" Margin="0,6" CornerRadius="14" Background="{DynamicResource IslandBtn}" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=notes}">
                    <TextBox x:Name="NotesBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Hidden" Background="Transparent" BorderThickness="0" Padding="10,8"
                             Foreground="{DynamicResource IslandFg}" CaretBrush="White" FontSize="13" SelectionBrush="{DynamicResource Accent}"/>
                </Border>

                <!-- tabs -->
                <DockPanel Grid.Row="2" VerticalAlignment="Center">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="{Binding VolumeGlyph}" FontSize="14" Width="30" Height="28" Tag="sysmute" Click="OnAction" ToolTip="Mute / unmute"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="30,0,0,0">
                        <Button Style="{StaticResource TabBtn}" Tag="tab:home" Click="OnAction" Background="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=home}" ToolTip="Home">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" FontSize="13"/>
                                <TextBlock Text="Home" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=home}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TabBtn}" Tag="tab:claude" Click="OnAction" Background="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=claude}" ToolTip="Claude Code">
                            <StackPanel Orientation="Horizontal">
                                <Image Style="{StaticResource ClaudeMark}" Width="13" Height="13"/>
                                <TextBlock Text="Claude" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=claude}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TabBtn}" Tag="tab:music" Click="OnAction" Background="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=music}" ToolTip="Music">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="13"/>
                                <TextBlock Text="Music" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=music}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TabBtn}" Tag="tab:rem" Click="OnAction" Background="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=rem}" ToolTip="Reminders">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FD;" FontSize="13"/>
                                <TextBlock Text="Reminders" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=rem}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TabBtn}" Tag="tab:notes-in" Click="OnAction" Background="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=notes-in}" ToolTip="Notifications">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BD;" FontSize="13"/>
                                <TextBlock Text="Messages" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=notes-in}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TabBtn}" Tag="tab:timer" Click="OnAction" Background="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=timer}" ToolTip="Focus timer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="13"/>
                                <TextBlock Text="Timer" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=timer}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TabBtn}" Tag="tab:tray" Click="OnAction" Background="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=tray}" ToolTip="File tray">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7B8;" FontSize="13"/>
                                <TextBlock Text="Tray" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=tray}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TabBtn}" Tag="tab:clip" Click="OnAction" Background="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=clip}" ToolTip="Clipboard history">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" FontSize="13"/>
                                <TextBlock Text="Clipboard" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=clip}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TabBtn}" Tag="tab:notes" Click="OnAction" Background="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=notes}" ToolTip="Notes">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70B;" FontSize="13"/>
                                <TextBlock Text="Notes" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding Tab, Converter={StaticResource Tab}, ConverterParameter=notes}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Album light: the cover's colour glowing out from under the island. Two blurred layers
             (a tight bright core and a wide faint bloom) fall off smoothly like real light; it
             follows the pill's size and movement, sits a little lower (light spills downward),
             and breathes slowly while the song plays. Cached as a bitmap so the blur isn't redone
             every frame. -->
        <Grid x:Name="Aura" Margin="14,11,14,0" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False"
              Width="{Binding ActualWidth, ElementName=Pill}" Height="{Binding ActualHeight, ElementName=Pill}"
              RenderTransform="{Binding RenderTransform, ElementName=Pill}" RenderTransformOrigin="{Binding RenderTransformOrigin, ElementName=Pill}">
            <Grid.CacheMode>
                <BitmapCache RenderAtScale="0.5"/>
            </Grid.CacheMode>
            <Border x:Name="AuraBloom" Margin="-10,-6,-10,-10" Opacity="0.4"
                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Radius}}">
                <Border.Effect>
                    <BlurEffect Radius="38" KernelType="Gaussian" RenderingBias="Quality"/>
                </Border.Effect>
            </Border>
            <Border x:Name="AuraCore" Margin="-3,-2,-3,-4"
                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Radius}}">
                <Border.Effect>
                    <BlurEffect Radius="14" KernelType="Gaussian" RenderingBias="Quality"/>
                </Border.Effect>
            </Border>
        </Grid>

        <Border x:Name="Pill" Width="190" Height="34" Margin="14,8,14,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                Opacity="0" Background="{DynamicResource IslandBg}" BorderBrush="{DynamicResource IslandBorder}" BorderThickness="1"
                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Radius}}"
                ClipToBounds="True"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown" MouseMove="Pill_MouseMove" MouseLeftButtonUp="Pill_MouseLeftButtonUp"
                MouseRightButtonUp="Pill_MouseRightButtonUp" MouseWheel="Pill_MouseWheel"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave" Cursor="Hand">
            <Border.RenderTransform>
                <TransformGroup>
                    <!-- appear / disappear -->
                    <ScaleTransform x:Name="PillScale" ScaleX="0.5" ScaleY="0.5"/>
                    <!-- press squish -->
                    <ScaleTransform x:Name="PressScale"/>
                    <!-- liquid morph between views -->
                    <ScaleTransform x:Name="MorphScale"/>
                    <!-- flick up to dismiss -->
                    <TranslateTransform x:Name="FlickMove"/>
                </TransformGroup>
            </Border.RenderTransform>
            <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- the second activity, in a small circle beside the island; click to swap -->
        <Border x:Name="Bubble" Width="34" Height="34" CornerRadius="17" Margin="14,8,14,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                Opacity="0" IsHitTestVisible="False" Background="{DynamicResource IslandBg}" BorderBrush="{DynamicResource IslandBorder}" BorderThickness="1"
                ClipToBounds="True" Cursor="Hand" RenderTransformOrigin="0.5,0.5" ToolTip="Click to swap"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown" MouseLeftButtonUp="Bubble_MouseLeftButtonUp" MouseLeave="Bubble_MouseLeave">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale" ScaleX="0.3" ScaleY="0.3"/>
                    <ScaleTransform x:Name="BubblePress"/>
                    <TranslateTransform x:Name="BubbleShift"/>
                </TransformGroup>
            </Border.RenderTransform>
            <ContentPresenter x:Name="BubblePresenter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- camera in use (green, like iPhone) -->
        <Ellipse x:Name="PrivacyDot" Width="9" Height="9" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="14,20,14,0"
                 Opacity="0" IsHitTestVisible="False" Fill="{DynamicResource Good}">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="DotShift"/>
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</Window>
