<Window x:Class="DyIsd.ControlCenter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DyIsd Control Center"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="436" SizeToContent="Height"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="White"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="Margin" Value="4,18,0,8"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- rounded button -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource Chip}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WhiteBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style x:Key="BlueBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0,11"/>
        </Style>
        <Style x:Key="GhostIcon" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- chip: small toggle, white when selected -->
        <Style x:Key="ChipToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="B" Background="{DynamicResource Chip}" CornerRadius="10" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.85"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS-style on/off switch -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="44" Height="26" CornerRadius="13" Background="#39393D">
                            <Ellipse x:Name="Thumb" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="Move"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Good}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Move" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.22"/></Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="Move" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22"/></Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- dark text box with a placeholder (put the placeholder text in Tag) -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="B" Background="{DynamicResource Chip}" CornerRadius="10" Padding="10,8" BorderThickness="2" BorderBrush="Transparent">
                            <Grid>
                                <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Foreground="#66FFFFFF" IsHitTestVisible="False" Visibility="Collapsed" Margin="2,0,0,0"/>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value=""><Setter TargetName="Ph" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12,6,12,20">
        <!-- shadow on its own layer so text stays crisp -->
        <Border CornerRadius="28" Background="{DynamicResource Panel}">
            <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.45"/></Border.Effect>
        </Border>
        <Border x:Name="Panel" CornerRadius="28" Background="{DynamicResource Panel}" BorderBrush="#14FFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform><ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden" MaxHeight="640">
                <StackPanel Margin="16,16,16,16">

                    <!-- header -->
                    <DockPanel>
                        <Image x:Name="Logo" DockPanel.Dock="Left" Width="30" Height="30"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostIcon}" Content="&#xE711;" Click="Close_Click" ToolTip="Close" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DyIsd" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Text="Click the island · hold Ctrl + Space for Jarvis" Style="{StaticResource Sub}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- jarvis -->
                    <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="14" Margin="0,14,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="40" Height="40" VerticalAlignment="Top">
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#64D2FF" Offset="0"/>
                                            <GradientStop Color="#5E5CE6" Offset="0.55"/>
                                            <GradientStop Color="#BF5AF2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" Foreground="White" FontSize="17"/>
                            </Grid>
                            <Button x:Name="JarvisBtn" DockPanel.Dock="Right" Style="{StaticResource WhiteBtn}" Content="Get it" VerticalAlignment="Top" Click="Jarvis_Click"/>
                            <StackPanel Margin="12,0,8,0">
                                <TextBlock Text="Jarvis" FontWeight="SemiBold" FontSize="13.5" Margin="0,1,0,3"/>
                                <TextBlock x:Name="JarvisSub" Style="{StaticResource Sub}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- focus -->
                    <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="14" Margin="0,8,0,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Orange}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" Foreground="Black" FontSize="18"/>
                            </Border>
                            <Button x:Name="FocusBtn" DockPanel.Dock="Right" Style="{StaticResource WhiteBtn}" Content="Start" VerticalAlignment="Top" Click="Focus_Click"/>
                            <StackPanel Margin="12,0,8,0">
                                <TextBlock x:Name="FocusTitle" Text="Focus session" FontWeight="SemiBold" FontSize="13.5" Margin="0,1,0,6"/>
                                <WrapPanel x:Name="FocusChips"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- deadlines -->
                    <TextBlock Style="{StaticResource Section}" Text="DEADLINES &amp; CLASSES"/>
                    <Border Background="{DynamicResource Card}" CornerRadius="16" ClipToBounds="True">
                        <StackPanel x:Name="DeadlineList"/>
                    </Border>

                    <Border Background="{DynamicResource Card}" CornerRadius="16" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBox x:Name="NewTitle" Style="{StaticResource Field}" Tag="What's due? e.g. DBMS assignment" MaxLength="60"/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Day" Style="{StaticResource Sub}" FontWeight="SemiBold" Width="54" Margin="0,5,0,0"/>
                                <StackPanel>
                                    <WrapPanel x:Name="DayChips"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostIcon}" Content="&#xE76B;" Click="DayPrev_Click" ToolTip="Day before" Padding="6"/>
                                        <TextBlock x:Name="DayLabel" MinWidth="120" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"/>
                                        <Button Style="{StaticResource GhostIcon}" Content="&#xE76C;" Click="DayNext_Click" ToolTip="Day after" Padding="6"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Time" Style="{StaticResource Sub}" FontWeight="SemiBold" Width="54" Margin="0,5,0,0"/>
                                <WrapPanel x:Name="TimeChips">
                                    <TextBox x:Name="CustomTime" Style="{StaticResource Field}" Tag="14:30" Width="72" FontSize="12" Margin="0,0,6,6" Padding="0" ToolTip="Type any time, like 14:30 or 9:15"/>
                                </WrapPanel>
                            </DockPanel>

                            <!-- reminders -->
                            <Border Height="1" Background="{DynamicResource Chip}" Margin="0,4,0,10"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Remind" Style="{StaticResource Sub}" FontWeight="SemiBold" Width="54" Margin="0,5,0,0"/>
                                <WrapPanel x:Name="BeforeChips"/>
                            </DockPanel>
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Repeat" Style="{StaticResource Sub}" FontWeight="SemiBold" Width="54" Margin="0,5,0,0"/>
                                <WrapPanel x:Name="RepeatChips">
                                    <StackPanel x:Name="RepeatTimeRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
                                        <TextBlock Text="at" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="2,0,6,0"/>
                                        <TextBox x:Name="RepeatTime" Style="{StaticResource Field}" Tag="9:00" Width="64" FontSize="12" Padding="0" ToolTip="Time for the daily or weekly reminder, e.g. 9:00 or 20:30"/>
                                    </StackPanel>
                                </WrapPanel>
                            </DockPanel>
                            <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Also on" Style="{StaticResource Sub}" FontWeight="SemiBold" Width="54" Margin="0,5,0,0"/>
                                <StackPanel>
                                    <WrapPanel x:Name="ExtraDates"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostIcon}" Content="&#xE76B;" Click="ExtraPrev_Click" ToolTip="Day before" Padding="6"/>
                                        <TextBlock x:Name="ExtraDayLabel" MinWidth="84" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"/>
                                        <Button Style="{StaticResource GhostIcon}" Content="&#xE76C;" Click="ExtraNext_Click" ToolTip="Day after" Padding="6"/>
                                        <TextBox x:Name="ExtraTime" Style="{StaticResource Field}" Tag="18:00" Width="64" FontSize="12" Padding="0" Margin="4,0,6,0" ToolTip="Time, e.g. 18:00"/>
                                        <Button x:Name="ExtraAdd" Style="{StaticResource Btn}" Content="+ Add" Padding="10,5" Click="ExtraAdd_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock x:Name="AddPreview" Style="{StaticResource Sub}" Margin="2,8,0,8"/>
                            <Button x:Name="AddBtn" Style="{StaticResource BlueBtn}" Content="Add deadline" Click="Add_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Card}" CornerRadius="16" Padding="14,12" Margin="0,8,0,0">
                        <DockPanel>
                            <Ellipse x:Name="CalDot" DockPanel.Dock="Left" Width="10" Height="10" Fill="#636366" VerticalAlignment="Center"/>
                            <Button x:Name="CalBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Paste link" Click="Calendar_Click" VerticalAlignment="Center"/>
                            <StackPanel Margin="12,0,10,0">
                                <TextBlock x:Name="CalTitle" Text="No calendar connected" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CalSub" Style="{StaticResource Sub}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- feature tiles -->
                    <TextBlock Style="{StaticResource Section}" Text="SHOW ON THE ISLAND"/>
                    <UniformGrid x:Name="Tiles" Columns="2"/>

                    <!-- position -->
                    <!-- your own Jarvis phrases -->
                    <TextBlock Style="{StaticResource Section}" Text="YOUR JARVIS PHRASES"/>
                    <Border Background="{DynamicResource Card}" CornerRadius="16" ClipToBounds="True">
                        <StackPanel x:Name="PhraseList"/>
                    </Border>
                    <Border Background="{DynamicResource Card}" CornerRadius="16" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBox x:Name="PhraseSay" Style="{StaticResource Field}" Tag="When I say… e.g. lab mode" MaxLength="40"/>
                            <TextBox x:Name="PhraseDo" Style="{StaticResource Field}" Tag="Jarvis does… e.g. open vs code and open chrome and play apple music" Margin="0,8,0,0" MaxLength="240"/>
                            <Button x:Name="PhraseAdd" Style="{StaticResource BlueBtn}" Content="Add phrase" Margin="0,8,0,0" Click="PhraseAdd_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Section}" Text="POSITION"/>
                    <Border Background="{DynamicResource Card}" CornerRadius="12" Padding="3">
                        <UniformGrid x:Name="PosButtons" Columns="3"/>
                    </Border>

                    <!-- options -->
                    <TextBlock Style="{StaticResource Section}" Text="OPTIONS"/>
                    <Border Background="{DynamicResource Card}" CornerRadius="16">
                        <StackPanel x:Name="Options"/>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,16,0,0">
                        <Button x:Name="PauseBtn" Style="{StaticResource Btn}" Content="Pause island" Margin="0,0,4,0" Click="Pause_Click"/>
                        <Button Style="{StaticResource Btn}" Content="Log folder" Margin="4,0,4,0" Click="Logs_Click" ToolTip="Open the folder with log.txt (send it if something breaks)"/>
                        <Button Style="{StaticResource Btn}" Content="Quit DyIsd" Margin="4,0,0,0" Click="Quit_Click"/>
                    </UniformGrid>
                    <TextBlock x:Name="Footer" Style="{StaticResource Sub}" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="10.5"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
