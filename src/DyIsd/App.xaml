<Application x:Class="DyIsd.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DyIsd.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <c:RadiusConverter x:Key="Radius"/>
        <c:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <c:InverseBoolToVisConverter x:Key="InverseBoolToVis"/>

        <!-- Default colors. ThemeService sets the real ones at startup. -->
        <SolidColorBrush x:Key="IslandBg" Color="#F72B2B2D"/>
        <SolidColorBrush x:Key="IslandBorder" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="IslandFg" Color="White"/>
        <SolidColorBrush x:Key="IslandMute" Color="#B9B9B9"/>
        <SolidColorBrush x:Key="IslandTrack" Color="#2BFFFFFF"/>
        <SolidColorBrush x:Key="IslandHover" Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="IslandBtn" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
        <SolidColorBrush x:Key="OnAccent" Color="Black"/>
        <SolidColorBrush x:Key="Good" Color="#6CCB5F"/>
        <SolidColorBrush x:Key="Bad" Color="#FF99A4"/>
    </Application.Resources>
</Application>
